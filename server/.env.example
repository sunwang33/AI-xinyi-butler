# 心意管家 AI 网关环境变量（复制为 .env，由 PM2 注入；.env 不得提交）
# 服务监听端口（Nginx 反代到 127.0.0.1:此端口）
PORT=3210

# DeepSeek 服务端密钥（原 Supabase Edge secret：DEEPSEEK_API_KEY，搬到本机）
# 绝不能进 App 与代码库；仅服务端持有
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase 项目（校验登录用户 JWT 用；机房出口直连首尔项目，实测可达）
SUPABASE_URL=https://wohcvgarvrizbbcepggg.supabase.co
# 项目 anon key（与 App 内同一把；匿名通道靠它 + IP 限频挡住裸刷）
SUPABASE_ANON_KEY=替换为-anon-key

# 限频：每 IP（匿名）/ 每登录用户 每分钟最多请求数
ANON_RATE_PER_MIN=24
USER_RATE_PER_MIN=30

# 上游模型超时（毫秒）
UPSTREAM_TIMEOUT_MS=25000
