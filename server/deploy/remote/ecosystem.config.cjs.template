        DEEPSEEK_API_KEY: '@@DEEPSEEK_API_KEY@@',
        SUPABASE_URL: '@@SUPABASE_UPSTREAM@@',
        SUPABASE_ANON_KEY: '@@SUPABASE_ANON_KEY@@',
        ANON_RATE_PER_MIN: '@@ANON_RATE_PER_MIN@@',
