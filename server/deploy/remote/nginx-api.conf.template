# 心意管家 · 备案子域 Nginx 配置模板（一键部署用，占位符如 @@DOMAIN@@ 由 setup-host.sh 渲染）
# 占位符用双 @ 包裹大写变量名（如 DOMAIN），避免 envsubst 误伤 Nginx 原生变量（$host/$remote_addr 等保持原样）。
#
# 渲染后落到：/etc/nginx/conf.d/@@NGINX_CONF@@（实际文件名见 deploy.env 的 NGINX_CONF）
# 一个 server 组承载两类反代：
#   1. AI 生成网关 /api/generate → 本机 Node 127.0.0.1:@@APP_PORT@@
#   2. Supabase /auth/v1/、/rest/v1/（含旧 Edge 回退）→ @@SUPABASE_UPSTREAM@@
# 其他路径一律 404，绝不做成开放代理。

# HTTP：仅放行 ACME 续期校验，其余跳 HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN@@;
    # certbot webroot 自动续期依赖此 location，勿删（webroot 根 = /usr/share/nginx/html）
    location /.well-known/acme-challenge/ { root /usr/share/nginx/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    # ipv6only=on 与同机其他 vhost 的 [::]:443 选项保持一致，避免 duplicate listen options
    listen [::]:443 ssl;
    server_name @@DOMAIN@@;

    # certbot webroot 签发的证书路径（certonly --webroot）
    ssl_certificate     /etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # 入参都是短文本，服务端还会再拦一道，1m 足够
    client_max_body_size 1m;

    # ---------- ① AI 生成网关 ----------
    location = /health {
        proxy_pass http://127.0.0.1:@@APP_PORT@@/health;
        proxy_set_header Host $host;
    }

    location = /api/generate {
        proxy_pass http://127.0.0.1:@@APP_PORT@@/api/generate;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 关键：覆盖而非追加，服务端取 XFF 链首做匿名限频，防止客户端伪造
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # DeepSeek 上游最坏 ~25s，给 60s 余量
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # ---------- ② Supabase 反代（认证 + 数据 REST；限路径白名单）----------
    # 回源必须宣告正确的 Host/SNI，Supabase 边缘按域名路由
    location ^~ /auth/v1/ {
        proxy_pass @@SUPABASE_UPSTREAM@@;
        proxy_ssl_server_name on;
        proxy_set_header Host @@SUPABASE_HOST@@;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ^~ /rest/v1/ {
        proxy_pass @@SUPABASE_UPSTREAM@@;
        proxy_ssl_server_name on;
        proxy_set_header Host @@SUPABASE_HOST@@;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 旧 Edge Function 反代仅为 App「edge 回退通道」保留；网关稳定后可删此段并停用函数。
    # supabase-js invoke 走精确路径，故用精确匹配——其他函数名一律落不到这里。
    location = /functions/v1/generate-content {
        proxy_pass @@SUPABASE_UPSTREAM@@;
        proxy_ssl_server_name on;
        proxy_set_header Host @@SUPABASE_HOST@@;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---------- 其余一切拒绝：本子域无网页、无其他服务 ----------
    location / {
        return 404;
    }
}
