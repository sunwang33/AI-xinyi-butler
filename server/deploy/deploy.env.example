# 一键部署变量样板。复制为同目录 deploy.env 并填真实值：
#   cp deploy.env.example deploy.env
# 真实 deploy.env 含 DeepSeek 密钥，已被 .gitignore 忽略，绝不提交。
# 换机时只需改本文件顶部的主机/域名，其余参数一般沿用。

# ---------- 本机 → 主机的 SSH 连接 ----------
SSH_HOST=124.223.173.79
SSH_USER=root
# 私钥路径（支持 ~ 展开）；若用 ssh-agent 留空即可
SSH_KEY=~/.ssh/codex_tencent_migration
SSH_PORT=22

# ---------- 站点与目录 ----------
# 备案子域（须已加 A 记录指向 SSH_HOST，且 80/443 在云安全组放行）
DOMAIN=api.talentspec.top
# PM2 进程名 / 主机部署目录 / 网关本机监听端口
APP_NAME=xinyi-gateway
APP_DIR=/www/wwwroot/xinyi-gateway
APP_PORT=3210
# Nginx 配置文件名（落到 /etc/nginx/conf.d/）
NGINX_CONF=xinyi-api.conf
# certbot 续期通知邮箱
CERT_EMAIL=your-mailbox@example.com

# ---------- 上游 Supabase（反代目标，首尔项目原域名）----------
SUPABASE_UPSTREAM=https://wohcvgarvrizbbcepggg.supabase.co
# 由上游 URL 自动派生 Host，一般无需手改；setup 脚本会算，这里留空即可
SUPABASE_HOST=

# ---------- 网关密钥与运行参数（真实值只填在 deploy.env，勿回填本样板）----------
DEEPSEEK_API_KEY=sk-在此填入真实密钥
SUPABASE_ANON_KEY=在此填入与 App 同一把 anon key
ANON_RATE_PER_MIN=24
USER_RATE_PER_MIN=30
UPSTREAM_TIMEOUT_MS=25000
